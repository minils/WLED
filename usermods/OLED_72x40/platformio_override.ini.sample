; ESP32-C3 "0.42 inch OLED" Board (72x40 SSD1306 on SDA=GPIO5, SCL=GPIO6, Addr 0x3C)
; Copy to the WLED root as platformio_override.ini and run: pio run -e esp32c3_oled42
[platformio]
default_envs = esp32c3_oled42

[env:esp32c3_oled42]
extends = env:esp32c3dev
custom_usermods = OLED_72x40
build_flags = ${env:esp32c3dev.build_flags}
  -D I2CSDAPIN=5        ; preset global I2C pins (can be changed in Config > Usermods)
  -D I2CSCLPIN=6
  -D DATA_PINS=4        ; default LED data pin (GPIO8/9 are strapping pins, GPIO8 = onboard LED)
